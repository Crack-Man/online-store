upstream php-upstream {
    server php:9000;
}

# Редирект с HTTP на HTTPS
server {
    listen 80;
    listen [::]:80;

    server_name ${API_DOMAIN};

    return 301 https://$host$request_uri;
}

server {
    # HTTP/3 (QUIC)
    listen ${API_PORT} quic reuseport;
    listen [::]:${API_PORT} quic reuseport;

    # HTTP/2 и HTTP/1.1
    listen ${API_PORT} ssl;
    listen [::]:${API_PORT} ssl;
    http2 on;

    server_name ${API_DOMAIN};

    # SSL-сертификаты — пути задаются через переменные окружения,
    # чтобы можно было использовать Let's Encrypt, самоподписанные или корпоративные сертификаты.
    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_early_data on;

    ssl_stapling off;
    ssl_stapling_verify off;

    # HTTP/3 заголовки — сообщают браузеру, что сервер поддерживает QUIC
    http3 on;
    quic_retry on;
    add_header Alt-Svc 'h3=":${API_PORT}"; ma=86400';
    add_header QUIC-Status $http3;

    proxy_set_header X-Forwarded-Proto https;

    root /srv/api/public;
    index index.php index.html index.htm;
    client_max_body_size 50M;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location /media/ {
        autoindex on;
        alias /srv/api/media/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public";
    }

    location /documents/ {
        autoindex on;
        alias /srv/api/documents/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public";
    }

    location /storage/ {
        autoindex on;
        alias /srv/api/private/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public";
    }

    location ~ \.php$ {
        try_files $uri /index.php =404;
        fastcgi_pass php-upstream;
        fastcgi_index index.php;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 600;
        include fastcgi_params;
    }

    location ~ /\.ht {
        deny all;
    }

    error_log  /var/log/nginx/api-error.log warn;
    access_log /var/log/nginx/api-access.log;
}
